{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starforge.example/schemas/compatibility-v1.json",
  "title": "StarForge compatibility status v1",
  "type": "object",
  "required": ["schema_version", "matrix_version", "evaluated_at", "level", "features", "findings"],
  "properties": {
    "schema_version": { "const": 1 },
    "matrix_version": { "type": "string", "minLength": 10 },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "level": { "enum": ["compatible", "degraded", "unknown", "incompatible"] },
    "protocol_version": { "type": ["integer", "null"], "minimum": 0 },
    "endpoint": { "type": ["object", "null"] },
    "features": { "type": "array" },
    "findings": { "type": "array" }
  },
  "additionalProperties": true
}
